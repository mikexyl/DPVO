# Defaults for the isolated JetPack 6.2 deployment; source with set -a.
DPVO_JETSON_IMAGE=dpvo:jetson-jp62-viser
DPVO_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3-igpu
DPVO_CONTAINER_NAME=dpvo-jp62-viewer
DPVO_WEB_PORT=9090
# This board currently has a USB 2 camera link: full-FOV 1280x800 supports 8 Hz.
DPVO_CAMERA_STRIDE=1
DPVO_CAMERA_FPS=8
DPVO_BUILD_JOBS=2
DPVO_CAMERA_FORMAT=yuyv
