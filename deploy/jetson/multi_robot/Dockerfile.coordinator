# CPU-only coordinator. CBS bundle must match this image's CPU architecture.
FROM ros:jazzy-ros-base
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-rmw-cyclonedds-cpp python3-colcon-common-extensions python3-venv \
      python3-numpy python3-scipy python3-yaml && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/viewer && \
    /opt/viewer/bin/pip install --timeout 120 --retries 5 --no-cache-dir viser==1.1.0
COPY ros2 /opt/online_ws/src
RUN source /opt/ros/jazzy/setup.bash && cd /opt/online_ws && \
    colcon build --packages-select dpvo_multi_robot_interfaces dpvo_multi_robot
COPY deploy/jetson/multi_robot/bundle /opt/cbs
RUN LD_LIBRARY_PATH=/opt/cbs/lib ldd /opt/cbs/bin/cbs_dpvo_sim3_offline > /tmp/cbs-ldd.txt && \
    ! grep -q 'not found' /tmp/cbs-ldd.txt
COPY dpvo /opt/dpvo/dpvo
COPY deploy/jetson/multi_robot /opt/dpvo/deploy/jetson/multi_robot
RUN cp /opt/dpvo/deploy/jetson/multi_robot/cbs_run.sh /opt/cbs/run && chmod +x /opt/cbs/run
ENV PATH=/opt/viewer/bin:$PATH \
    DPVO_USE_SYSTEM_PYTHON=1 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp PYTHONUNBUFFERED=1
WORKDIR /opt/dpvo
ENTRYPOINT ["bash", "/opt/dpvo/deploy/jetson/multi_robot/entrypoint.sh"]
CMD ["python", "deploy/jetson/multi_robot/coordinator.py"]
